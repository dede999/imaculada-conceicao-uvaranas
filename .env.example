# Public site hostname (Caddy + Let's Encrypt). Point DNS A/AAAA here first.
DOMAIN=paroquia.example.com

# Image used by compose on the VPS (CI sets this per deploy; override for local builds).
# WEB_IMAGE=ghcr.io/dede999/imaculada-conceicao-uvaranas:latest

# Supabase (URL + anon key are public by design; service role is server-only)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_KEY=eyJ...
NUXT_SUPABASE_SECRET_KEY=eyJ...
SUPABASE_SERVICE_KEY=eyJ...

# Parish row id: SELECT id FROM parishes WHERE slug='imaculada-conceicao';
PARISH_ID=aaaaaaaa-0000-4000-8000-000000000001
